{
  "name": "@gg-utils/opentui-ui-kit",
  "version": "0.2.0",
  "type": "module",
  "description": "Reusable OpenTUI component primitives for terminal command surfaces.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./spinner": {
      "types": "./dist/spinner/index.d.ts",
      "default": "./dist/spinner/index.js"
    },
    "./progress": {
      "types": "./dist/progress/index.d.ts",
      "default": "./dist/progress/index.js"
    },
    "./input": {
      "types": "./dist/input/index.d.ts",
      "default": "./dist/input/index.js"
    },
    "./select": {
      "types": "./dist/select/index.d.ts",
      "default": "./dist/select/index.js"
    },
    "./status": {
      "types": "./dist/status/index.d.ts",
      "default": "./dist/status/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "default": "./dist/layout/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "tsc -p tsconfig.test.json && node --test \".test-dist/**/*.unit.test.js\"",
    "check:dist": "sh scripts/check-dist.sh"
  },
  "dependencies": {
    "@opentui/core": "^0.1.90",
    "@opentui/react": "^0.1.90",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript-eslint": "8.72.2"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=22.0.0 <27",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "opentui",
    "terminal",
    "cli",
    "components",
    "react",
    "tui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gg-utils/opentui-ui-kit.git"
  }
}
